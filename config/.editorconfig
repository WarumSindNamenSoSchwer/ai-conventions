# MCS editor settings. Source of truth: ai-conventions/config/.editorconfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx,inc}]
max_line_length = 100

[{Makefile,makefile,*.mk}]
indent_style = tab

[*.{cmd,bat,ps1}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml}]
indent_size = 2
