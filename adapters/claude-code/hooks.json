{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|MultiEdit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.mcs/adapters/claude-code/py.sh\" \"${CLAUDE_PROJECT_DIR}/.mcs/guard/guard.py\" --agent claude-code",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.mcs/adapters/claude-code/py.sh\" \"${CLAUDE_PROJECT_DIR}/.mcs/bin/mcs\" check --session-start",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
