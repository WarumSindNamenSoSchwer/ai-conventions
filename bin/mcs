#!/usr/bin/env python3
"""mcs: plan approval, plan index, setup check.

    mcs approve <plan>     human-only approval of Docs/Plans/<plan>.md
    mcs status             list plans, regenerate Docs/Plans/index.md
    mcs check              verify project setup, report guard errors
    mcs check --machine    list projects using the Jcode dispatcher
    mcs setup | uninstall  called by setup.sh / setup.ps1 and uninstall.*

Standard library only, Python 3.10+.
"""

import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE.parent / "guard"))
sys.path.insert(0, str(HERE))

import plans  # noqa: E402
import mcs_setup  # noqa: E402

AGENT_ENV = ("CLAUDECODE", "CLAUDE_CODE_SESSION_ID", "JCODE_SESSION_ID")


def git(root, *args):
    out = subprocess.run(["git", *args], cwd=root, capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else ""


def project_root():
    top = git(os.getcwd(), "rev-parse", "--show-superproject-working-tree") or \
        git(os.getcwd(), "rev-parse", "--show-toplevel")
    return Path(top or os.getcwd())


def resolve_plan(root, name):
    p = Path(name)
    candidates = [root / p, root / "Docs" / "Plans" / p,
                  root / "Docs" / "Plans" / (p.name if p.suffix == ".md" else p.name + ".md")]
    for c in candidates:
        if c.is_file() and c.suffix == ".md":
            return c
    return None


def plan_state(text, path=None):
    meta, _ = plans.split_front_matter(text)
    status = meta.get("status", "draft") or "draft"
    if status == "approved" and meta.get("approval_hash") != plans.body_hash(text):
        return "changed after approval", meta
    return status, meta


def cmd_approve(args):
    if len(args) != 1:
        print("usage: mcs approve <plan>", file=sys.stderr)
        return 1
    if any(os.environ.get(v) for v in AGENT_ENV):
        print("mcs approve refused: this shell belongs to an agent session. "
              "Run it in your own terminal.", file=sys.stderr)
        return 1
    root = project_root()
    path = resolve_plan(root, args[0])
    if path is None:
        print(f"plan not found: {args[0]} (looked in Docs/Plans/)", file=sys.stderr)
        return 1
    branch = git(root, "symbolic-ref", "--short", "-q", "HEAD")
    if not branch:
        print("refused: not on a branch (detached HEAD). Approval is bound to a branch.",
              file=sys.stderr)
        return 1
    text = path.read_text(encoding="utf-8")
    problems = plans.missing_sections(text, path)
    if problems:
        print(f"refused: {path.name} is not ready for approval:", file=sys.stderr)
        for p in problems:
            print(f"  - {p}", file=sys.stderr)
        return 1
    name = path.stem
    print(f"Approve plan '{name}' for branch '{branch}'.")
    print(f"Type the plan name ({name}) to confirm: ", end="", flush=True)
    answer = sys.stdin.readline().strip()
    if answer != name:
        print("refused: name did not match, nothing changed.", file=sys.stderr)
        return 1
    approver = git(root, "config", "user.name") or os.environ.get("USER") or os.environ.get("USERNAME", "?")
    when = datetime.now(timezone.utc).replace(microsecond=0).isoformat()
    for other in plans.list_plans(root):
        if other == path:
            continue
        other_text = other.read_text(encoding="utf-8")
        meta, body = plans.split_front_matter(other_text)
        if meta.get("status") == "approved" and meta.get("branch") == branch:
            meta["status"] = "superseded"
            other.write_text(plans.join_front_matter(meta, body), encoding="utf-8", newline="\n")
            print(f"superseded: {other.name}")
    path.write_text(plans.approve_text(text, approver, branch, when), encoding="utf-8", newline="\n")
    write_index(root)
    print(f"approved: {path.name} by {approver} on {branch}")
    return 0


def write_index(root):
    rows = []
    for path in plans.list_plans(root):
        state, meta = plan_state(path.read_text(encoding="utf-8", errors="replace"))
        rows.append((path.name, path.stem, state, meta.get("branch", ""),
                     meta.get("approved_by", ""), meta.get("approved_at", "")))
    lines = ["# Plans", "", "Generated by `mcs status` and `mcs approve`. Do not edit by hand.", "",
             "| Plan | Status | Branch | Approved by | Approved at |", "|---|---|---|---|---|"]
    lines += [f"| [{stem}]({fname}) | {state} | {branch} | {by} | {at} |"
              for fname, stem, state, branch, by, at in rows]
    d = plans.plans_dir(root)
    if d.is_dir():
        (d / "index.md").write_text("\n".join(lines) + "\n", encoding="utf-8", newline="\n")
    return rows


def cmd_status(args):
    root = project_root()
    rows = write_index(root)
    if not rows:
        print("no plans in Docs/Plans/")
    for fname, _, state, branch, by, at in rows:
        extra = f" ({branch}, {by}, {at})" if branch else ""
        print(f"{state:24} {fname}{extra}")
    return 0


def cmd_check(args):
    if "--machine" in args:
        return mcs_setup.check_machine()
    root = project_root()
    issues = mcs_setup.check_project(root)
    log = root / ".mcs-guard.log"
    if log.is_file():
        errors = [l for l in log.read_text(encoding="utf-8", errors="replace").splitlines() if l.strip()]
        if errors:
            issues.append(f"{len(errors)} guard error(s) in .mcs-guard.log, last: {errors[-1][:200]}")
    if issues:
        print("mcs check: " + ("setup needs attention" if "--session-start" in args else "problems found"))
        for i in issues:
            print(f"  - {i}")
        print("Fix: run .mcs/setup.sh (macOS, Linux) or .mcs/setup.ps1 (Windows).")
    elif "--session-start" not in args:
        print("mcs check: ok")
    return 0 if ("--session-start" in args or not issues) else 1


def main(argv):
    commands = {"approve": cmd_approve, "status": cmd_status, "check": cmd_check,
                "setup": mcs_setup.cmd_setup, "uninstall": mcs_setup.cmd_uninstall}
    if not argv or argv[0] not in commands:
        print(__doc__.strip())
        return 1
    return commands[argv[0]](argv[1:])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
