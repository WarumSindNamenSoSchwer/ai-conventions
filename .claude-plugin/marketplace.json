    {
      "name": "clangd-lsp",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "plugins/clangd-lsp",
        "sha": "f359d43b406057f1a8cdbc4ea93b827642c162e6"
      },
      "description": "C/C++ language server, needs clangd (Apache-2.0)",
      "strict": false,
      "lspServers": {
        "clangd": {
          "command": "clangd",
          "args": [
            "--background-index"
          ],
          "extensionToLanguage": {
            ".c": "c",
            ".h": "c",
            ".cpp": "cpp",
            ".cc": "cpp",
            ".cxx": "cpp",
            ".hpp": "cpp",
            ".hxx": "cpp"
          }
        }
      }
    },
    {
      "name": "pyright-lsp",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/anthropics/claude-plugins-official.git",
        "path": "plugins/pyright-lsp",
        "sha": "f359d43b406057f1a8cdbc4ea93b827642c162e6"
      },
      "description": "Python language server, needs pyright (Apache-2.0)",
      "strict": false,
      "defaultEnabled": false,
      "lspServers": {
        "pyright": {
          "command": "pyright-langserver",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".py": "python",
            ".pyi": "python"
          }
        }
      }
    },
    {
      "name": "gopls-lsp",
